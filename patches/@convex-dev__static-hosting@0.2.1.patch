+// Patched (match.build): one dropped connection — a TLS "bad record mac",
+// a reset socket — used to fail the whole upload. Retry each request on
+// transport errors and 5xx, with backoff, before giving up.
+async function fetchWithRetry(url, init, attempts = 4) {
+    for (let attempt = 1;; attempt++) {
+        try {
+            const response = await fetch(url, init);
+            if (response.status < 500 || attempt >= attempts)
+                return response;
+            await response.body?.cancel();
+        }
+        catch (error) {
+            if (attempt >= attempts)
+                throw error;
+        }
+        await new Promise((r) => setTimeout(r, 500 * 2 ** (attempt - 1)));
+    }
+}
