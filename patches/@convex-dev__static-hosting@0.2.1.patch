+// Patched (match.build): one dropped connection — a TLS "bad record mac",
+// a destroyed HTTP/2 session — used to fail the whole upload. Node 26's
+// fetch speaks HTTP/2 and multiplexes every parallel upload over a single
+// session, so when that session dies every in-flight file (and every retry
+// that lands on it) fails with it. Post over node:https instead: HTTP/1.1,
+// its own connection per request, retried on transport errors and 5xx.
+function postOnce(url, init) {
+    const target = new URL(url);
+    const request = (target.protocol === "http:" ? httpRequest : httpsRequest);
+    return new Promise((resolvePost, rejectPost) => {
+        const req = request(target, {
+            method: init.method,
+            headers: { ...init.headers, "Content-Length": init.body.length },
+            agent: false,
+        }, (res) => {
+            const chunks = [];
+            res.on("data", (chunk) => chunks.push(chunk));
+            res.on("error", rejectPost);
+            res.on("end", () => {
+                const text = Buffer.concat(chunks).toString("utf8");
+                const status = res.statusCode ?? 0;
+                resolvePost({
+                    ok: status >= 200 && status < 300,
+                    status,
+                    statusText: res.statusMessage ?? "",
+                    json: async () => JSON.parse(text),
+                });
+            });
+        });
+        req.setTimeout(120_000, () => req.destroy(new Error("Upload timed out: " + target.pathname)));
+        req.on("error", rejectPost);
+        req.end(init.body);
+    });
+}
+async function fetchWithRetry(url, init, attempts = 4) {
+    for (let attempt = 1;; attempt++) {
+        try {
+            const response = await postOnce(url, init);
+            if (response.status < 500 || attempt >= attempts)
+                return response;
+        }
+        catch (error) {
+            if (attempt >= attempts)
+                throw error;
+        }
+        await new Promise((r) => setTimeout(r, 500 * 2 ** (attempt - 1)));
+    }
+}
